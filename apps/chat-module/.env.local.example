# Copy to .env.local (gitignored). Used only by the route handler app/api/chat (server-side).
# Free key: https://console.groq.com/keys — only send mock/dummy data (NDA, constitution §5).
GROQ_API_KEY=
# Optional
# GROQ_MODEL=qwen/qwen3.8-27b
# CHAT_ALLOWED_ORIGIN=https://tessera-shell.vercel.app

# Read by the browser bundle at BUILD time: absolute origin of this app (the Shell calls it cross-origin).
# Default http://localhost:3001
# NEXT_PUBLIC_CHAT_API_URL=https://tessera-chat-module.vercel.app

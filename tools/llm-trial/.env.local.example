# Copy this file to .env.local (đã trong .gitignore) và điền key bên dưới.
# KHÔNG commit .env.local. Chỉ dùng key thật cho request dữ liệu mẫu/dummy (NDA — xem
# .specify/constitution.md §5).

# Mặc định cho PoC — free tier, không phát sinh chi phí: https://console.groq.com/keys
GROQ_API_KEY=

# Tuỳ chọn — production-target, TRẢ PHÍ (chỉ điền nếu chủ động muốn test provider trả phí):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
